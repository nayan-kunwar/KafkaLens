{
  "name": "kafka-lens",
  "version": "0.2.1",
  "description": "MCP-powered Kafka investigation and diagnosis system for AI agents",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.js",
    "migrate": "tsx src/persistence/migrate-cli.ts",
    "retain": "tsx src/persistence/retain-cli.ts",
    "build:demo": "tsc -p tsconfig.demo.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "demo:up": "docker compose up -d",
    "demo:down": "docker compose down",
    "demo:slow-consumer": "tsx demo/slow-consumer.ts",
    "demo:stalled-consumer": "tsx demo/stalled-consumer.ts",
    "demo:partition-hotspot": "tsx demo/partition-hotspot.ts",
    "demo:producer-spike": "tsx demo/producer-spike.ts"
  },
  "keywords": [
    "kafka",
    "mcp",
    "model-context-protocol",
    "diagnostics",
    "consumer-lag"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^18.0.6",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "redis": "^6.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/kafka": "^12.2.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}

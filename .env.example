NODE_ENV=development
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kafka-inspector
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
KAFKA_SSL_REJECT_UNAUTHORIZED=true
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_CONNECTION_TIMEOUT_MS=10000
KAFKA_RETRY_ATTEMPTS=5
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/kafka_inspector
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_QUERY_TIMEOUT_MS=15000
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
PARTITION_IMBALANCE_RATIO=5
STALL_WINDOW_SECONDS=300
# npm run retain deletes rows older than these. 0 disables that table.
LAG_RETENTION_DAYS=14
INCIDENT_RETENTION_DAYS=90
CACHE_TTL_SECONDS=15
# Tool handler deadline. The underlying work cannot be cancelled.
TOOL_TIMEOUT_MS=60000
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
# GITHUB_REPOSITORY=owner/name
# GITHUB_TOKEN=
# DEPLOYMENT_SOURCE_URL=https://deployments.example/events
